{
  "manifest_version": 3,
  "name": "Gonona — AI Token & Prompt Bridge",
  "version": "0.1.0",
  "description": "Live under-composer token meter, model-aware msgs-left, and 1-click context bridge for ChatGPT, Claude, Gemini, and Grok.",
  "homepage_url": "https://gonona.vercel.app/",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chatglm.cn/*",
    "https://kimi.moonshot.cn/*",
    "https://grok.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chatglm.cn/*",
        "https://kimi.moonshot.cn/*",
        "https://grok.com/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chatglm.cn/*",
        "https://kimi.moonshot.cn/*",
        "https://grok.com/*"
      ],
      "js": [
        "site-config.js",
        "vendor/gpt-tokenizer.bundle.js",
        "tokenizer.js",
        "claude-tokens.js",
        "chatgpt-tokens.js",
        "optimizer.js",
        "meter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chatglm.cn/*",
        "https://kimi.moonshot.cn/*",
        "https://grok.com/*"
      ]
    }
  ]
}